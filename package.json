{
  "name": "mietfuchs",
  "version": "0.2.1",
  "private": true,
  "description": "Mietfuchs — lokales Web-Tool für Nebenkostenabrechnungen privater Vermieter",
  "author": "Martin Geörger",
  "license": "MIT",
  "homepage": "https://github.com/speedone/mietfuchs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speedone/mietfuchs.git"
  },
  "bugs": {
    "url": "https://github.com/speedone/mietfuchs/issues"
  },
  "keywords": [
    "nebenkostenabrechnung",
    "betriebskosten",
    "vermieter",
    "immobilien",
    "anlage-v"
  ],
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @mietfuchs/server\" \"npm run dev -w @mietfuchs/client\"",
    "test": "npm run test -w @mietfuchs/domain -w @mietfuchs/server",
    "typecheck": "npm run typecheck -w @mietfuchs/domain -w @mietfuchs/server -w @mietfuchs/client",
    "build": "npm run build -w @mietfuchs/client",
    "start": "npm run start -w @mietfuchs/server",
    "package": "node scripts/package-binaries.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
